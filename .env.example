# Осы файлды ".env" деп көшіріп, Railway мәндерін толтырыңыз.
# Railway → PostgreSQL → Connect → DATABASE_PUBLIC_URL (немесе DATABASE_URL)

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

SECRET_KEY=өз-құпия-кілтіңіз-ұзын-мәтін

